{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "getbutterfly/font-awesome",
    "title": "Font Awesome Icon",
    "category": "getbutterfly",
    "icon": "star-filled",
    "description": "Pick a Font Awesome icon from a searchable list. Free icons are output as inline SVG, so no icon font is loaded.",
    "keywords": ["font", "icon", "pictogram", "fontawesome", "fa", "svg"],
    "textdomain": "block-for-font-awesome",
    "attributes": {
        "icon": {
            "type": "string",
            "default": ""
        },
        "label": {
            "type": "string",
            "default": ""
        },
        "faClass": {
            "type": "string",
            "default": ""
        },
        "faColor": {
            "type": "string",
            "default": ""
        },
        "fixedWidth": {
            "type": "boolean",
            "default": false
        },
        "newTab": {
            "type": "boolean",
            "default": false
        },
        "faLink": {
            "type": "string",
            "default": ""
        },
        "faAlign": {
            "type": "string",
            "default": "left"
        },
        "faSize": {
            "type": "string",
            "default": ""
        }
    },
    "supports": {
        "html": false,
        "anchor": true,
        "color": {
            "text": true,
            "background": true,
            "link": false
        },
        "spacing": {
            "margin": true,
            "padding": true
        },
        "typography": {
            "fontSize": true
        }
    },
    "example": {
        "attributes": {
            "icon": "solid/wand-magic-sparkles",
            "faSize": "fa-3x"
        }
    },
    "editorScript": "file:./block/edit.js",
    "style": "file:./assets/css/icons.css",
    "render": "file:./block/render.php"
}
